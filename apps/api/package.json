{
  "name": "@pulseops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/domain/metrics.test.ts src/insights/rules.test.ts test/analytics.integration.test.ts test/insights.integration.test.ts test/ai-gateway.test.ts test/http-errors.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:integrity": "tsx prisma/integrity.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@prisma/client": "^6.5.0",
    "@pulseops/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^16.15.0-beta.19",
    "@esbuild/win32-x64": "^0.28.2",
    "@types/node": "^22.13.10",
    "embedded-postgres": "^16.15.0-beta.19",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
