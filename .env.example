# Copie para .env na raiz e/ou apps/api/.env
# Valores abaixo são de DEMONSTRAÇÃO local — não use em produção.

# PostgreSQL (docker-compose.yml)
DATABASE_URL="postgresql://pulseops:pulseops@localhost:5432/pulseops?schema=public"

# API
API_HOST=0.0.0.0
API_PORT=3333
CORS_ORIGIN=http://localhost:5173

# Autenticação SIMULADA — inadequada para produção.
# Organização demo principal (Nova Horizontes). Preenchida pelo seed com UUID fixo.
DEMO_ORGANIZATION_ID="11111111-1111-4111-8111-111111111111"

# "Agora" controlável para métricas/testes determinísticos (ISO-8601 UTC)
DEMO_REFERENCE_NOW="2026-11-02T15:00:00.000Z"

# Web (Vite)
VITE_API_BASE_URL=http://localhost:3333

# Copiloto local. Token de demonstração, não é segredo de produção.
# O browser não usa este token. Só o Fastify o envia ao sidecar Python.
AI_SERVICE_URL=http://127.0.0.1:8090
AI_SERVICE_TOKEN=local-demo-ai-token
ANALYTICS_BASE_URL=http://127.0.0.1:3333
# Opcional. Sem uma destas chaves o provider fica mock.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# Diagnóstico local da resposta rejeitada. Desligado por padrão. Não registra a chave.
# PULSEOPS_AI_DIAGNOSTICS=1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
